NODE_ENV=development
# The local Docker Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://vinventory:vinventory@127.0.0.1:5433/vinventory_dev
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
# Development sign-in, no VAuth credentials needed. Development only:
# never set this in production.
VINVENTORY_DEV_AUTH=1
VOSS_DISCOVERY_URL=https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration
# Only needed for real VAuth sign-in; optional when VINVENTORY_DEV_AUTH=1.
# VOSS_CLIENT_ID=replace-with-registered-vinventory-client-id
# VOSS_CLIENT_SECRET=replace-with-registered-vinventory-client-secret
VAUTH_REDIRECT_URI=http://localhost:5173/api/auth/oauth2/callback/voss
